## Copy to finance_dashboard/hacks/.release.env (do not commit secrets)

# HA_URL="http://homeassistant:8123"
# HA_TOKEN="your-long-lived-access-token"
# REPO="https://github.com/jovanni-hernandez/homeassistant-finance-dashboard"
# Optional if git/gh auth is not already configured:
# GITHUB_TOKEN="your-github-token"
# Optional: override live Selenium target; default uses authenticated HA Ingress.
# FINANCE_DASHBOARD_URL="https://home-assistant.example/"
