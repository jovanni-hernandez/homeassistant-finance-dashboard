{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Finance: Bootstrap",
      "type": "shell",
      "command": ".devcontainer/bootstrap.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Finance: Run backend",
      "type": "shell",
      "command": "python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Finance: Check backend Python",
      "type": "shell",
      "command": "python3 -m py_compile backend/*.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Finance: Check frontend in browser",
      "type": "shell",
      "command": "FINANCE_DASHBOARD_URL=local ./hacks/validate-ui-selenium.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Finance: Build category defaults",
      "type": "shell",
      "command": "if [ -f \"${FINANCE_DB_PATH:-/data/finance.db}\" ]; then ./hacks/propose-category-rules.sh --format markdown; else echo 'No finance DB found; set FINANCE_DB_PATH to a readable test database.'; fi",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
